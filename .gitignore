# Runtime data (logs, rate-limit counters, private documents)
storage/*
!storage/.htaccess

# User uploads (listing photos)
uploads/*
!uploads/.htaccess

# Local configuration with database passwords
security/config.local.php
node_modules/

# Composer packages (run: composer install) and the Gmail settings with the app password
security/vendor/
security/mail.local.php
security/oauth.local.php

# Your own MySQL Workbench exports (real data) - see database/xampp/README.md
database/xampp/*.sql
!database/xampp/bhsystem-xampp.sql
